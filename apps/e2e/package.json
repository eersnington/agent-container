{
  "name": "@agent-container/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --dir ../.. --filter @agent-container/types build && pnpm --dir ../.. --filter @agent-container/test-utils build && pnpm --dir ../../packages/agent-container build",
    "test": "pnpm build:deps && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-container/test-utils": "workspace:*",
    "@agent-container/types": "workspace:*",
    "agent-container": "workspace:*",
    "vitest": "catalog:",
    "workerd": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
