{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "caughtErrorsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-explicit-any": "error",
    "no-unused-expressions": "warn",
    "no-this-alias": "off",
    "react-hooks/exhaustive-deps": "warn",
  },
  "env": {
    "builtin": true
  }
}
